# ============================================================
# .env.example – PhishGuard Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit the .env file to version control.
# ============================================================

# ── Flask ────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True                       # Set to False in production
LOG_LEVEL=INFO

# ── MySQL Database ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=                     # Your MySQL root password (or phishguard_user password)
DB_NAME=phishguard

# ── Analysis Settings ────────────────────────────────────────
MAX_EMAIL_SIZE_KB=500
ANALYSIS_TIMEOUT_SECONDS=10

# ── Language ─────────────────────────────────────────────────
DEFAULT_LANGUAGE=en
